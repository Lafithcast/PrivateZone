# Plantilla OPCIONAL para application-local.properties (archivo local, ignorado por git).
#
# Sin ese archivo, la aplicacion usa la conexion por defecto de application.properties
# (MySQL en localhost:3306, base private_zone, usuario usuario_private_zone).
#
# Solo crealo si usas otras credenciales o otro puerto de MySQL: copia este archivo
# como application-local.properties en esta misma carpeta (src/main/resources),
# descomenta las lineas de abajo y reemplaza los valores por los de tu equipo.
#
# Nunca subas credenciales reales al repositorio.

#spring.datasource.url=jdbc:mysql://localhost:3306/private_zone?useSSL=false&serverTimezone=America/Costa_Rica&allowPublicKeyRetrieval=true
#spring.datasource.username=tu_usuario
#spring.datasource.password=tu_password
